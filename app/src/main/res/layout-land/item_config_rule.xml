<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="3dp">

    <FrameLayout
        android:id="@+id/ruleHierarchyGuide"
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/ruleHierarchyLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_marginStart="12dp"
            android:background="@color/rule_hierarchy" />

        <View
            android:layout_width="14dp"
            android:layout_height="2dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:background="@color/rule_hierarchy" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/ruleDeleteAction"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_rule_swipe_delete"
        android:contentDescription="删除规则"
        android:padding="13dp"
        android:src="@drawable/ic_delete_swipe" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ruleForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/card_bg"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardForegroundColor="@android:color/transparent"
        app:strokeColor="#E7E7F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/ruleContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_bg"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/ruleType"
                android:layout_width="46dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_rule_type_thread"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/brand_primary_dark"
                android:textSize="10sp"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/ruleTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:requiresFadingEdge="horizontal"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@id/ruleExpand"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ruleExpand"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="1dp"
                    android:contentDescription="展开子线程"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/ruleTarget"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ruleTarget"
                    app:layout_constraintTop_toTopOf="@id/ruleTarget" />

                <TextView
                    android:id="@+id/ruleOwner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="middle"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="9.5sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ruleTarget" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/ruleCpus"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_rule_cpu"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="38dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#167A70"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/ruleEdit"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_rule_icon_button"
                android:contentDescription="编辑规则"
                android:padding="10dp"
                android:src="@drawable/ic_edit" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
